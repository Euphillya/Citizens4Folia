From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Thu, 13 Feb 2025 03:42:01 +0100
Subject: [PATCH 7/7] Fix schedule NPC

---
 .../net/citizensnpcs/api/LocationLookup.java     | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/src/main/java/net/citizensnpcs/api/LocationLookup.java b/src/main/java/net/citizensnpcs/api/LocationLookup.java
index 7b0d4d4..2bf229c 100644
--- a/src/main/java/net/citizensnpcs/api/LocationLookup.java
+++ b/src/main/java/net/citizensnpcs/api/LocationLookup.java
@@ -174,12 +174,16 @@ public class LocationLookup extends fr.euphyllia.utils.FoliaRunnable {
             Map<UUID, Collection<TreeFactory.Node<NPC>>> map = Maps.newHashMap();
             Location loc = new Location(null, 0, 0, 0);
             for (NPC npc : sourceRegistry) {
-                if (!npc.isSpawned())
-                    continue;
-                npc.getEntity().getLocation(loc);
-                Collection<TreeFactory.Node<NPC>> nodes = map.computeIfAbsent(npc.getEntity().getWorld().getUID(),
-                        uid -> Lists.newArrayList());
-                nodes.add(new TreeFactory.Node<>(new double[] { loc.getX(), loc.getY(), loc.getZ() }, npc));
+                if (npc == null) continue;
+                if (npc.getEntity() == null) continue;
+                npc.getEntity().getScheduler().run(CitizensAPI.getPlugin(), task -> {
+                    if (!npc.isSpawned())
+                        return;
+                    npc.getEntity().getLocation(loc);
+                    Collection<TreeFactory.Node<NPC>> nodes = map.computeIfAbsent(npc.getEntity().getWorld().getUID(),
+                            uid -> Lists.newArrayList());
+                    nodes.add(new TreeFactory.Node<>(new double[] { loc.getX(), loc.getY(), loc.getZ() }, npc));
+                }, null);
             }
             npcFuture = ForkJoinPool.commonPool().submit(new TreeFactory<>(map));
         }
