 1 file changed, 15 insertions(+)
 create mode 100644 src/main/java/fr/euphyllia/utils/EntityExtends.java

diff --git a/src/main/java/fr/euphyllia/utils/EntityExtends.java b/src/main/java/fr/euphyllia/utils/EntityExtends.java
