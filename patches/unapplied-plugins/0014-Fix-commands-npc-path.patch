From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Sat, 22 Mar 2025 02:08:34 +0100
Subject: [PATCH 14/15] Fix commands npc path

---
 .../citizensnpcs/commands/NPCCommands.java    | 40 +++++++++++--------
 .../npc/ai/CitizensNavigator.java             |  6 ++-
 .../npc/ai/MCNavigationStrategy.java          |  3 --
 3 files changed, 28 insertions(+), 21 deletions(-)

diff --git a/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java b/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
index 457a29bbc..6f88c3442 100644
--- a/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
+++ b/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
@@ -970,11 +970,11 @@ public class NPCCommands {
             final Location locationSpawn = spawnLoc;
             final NPC npcFinal = npc;
             if (type.equals(EntityType.PLAYER)) {
-                org.bukkit.Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), locationSpawn.getWorld().getSpawnLocation(), task -> {
+                Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), locationSpawn.getWorld().getSpawnLocation(), task -> {
                     npcFinal.spawn(locationSpawn, SpawnReason.CREATE);
                 });
             } else {
-                org.bukkit.Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), locationSpawn, task -> {
+                Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), locationSpawn, task -> {
                     npcFinal.spawn(locationSpawn, SpawnReason.CREATE);
                 });
             }
@@ -2376,27 +2376,33 @@ public class NPCCommands {
     public void pathto(CommandContext args, CommandSender sender, NPC npc,
             @Arg(value = 1, completions = { "me", "here", "cursor" }) String option, @Flag("margin") Double margin)
             throws CommandException {
-        Location loc = npc.getStoredLocation();
+        java.util.concurrent.atomic.AtomicReference<Location> loc = new java.util.concurrent.atomic.AtomicReference<>();
         if (args.argsLength() == 2) {
             if (option.equalsIgnoreCase("me") || option.equalsIgnoreCase("here")) {
-                loc = args.getSenderLocation();
+                loc.set(args.getSenderLocation());
             } else if (option.equalsIgnoreCase("cursor")) {
-                loc = ((Player) sender).getTargetBlockExact(32).getLocation();
+                loc.set(((Player) sender).getTargetBlockExact(32).getLocation());
             } else
                 throw new CommandUsageException();
-        } else {
-            loc.setX(args.getDouble(1));
-            loc.setY(args.getDouble(2));
-            loc.setZ(args.getDouble(3));
-        }
-        if (args.hasFlag('s')) {
-            npc.getNavigator().setStraightLineTarget(loc);
-        } else {
-            npc.getNavigator().setTarget(loc);
-        }
-        if (margin != null) {
-            npc.getNavigator().getLocalParameters().distanceMargin(margin);
         }
+
+        npc.getEntity().getScheduler().run(CitizensAPI.getPlugin(), task -> {
+            if (loc.get() == null) {
+                loc.set(npc.getStoredLocation());
+                loc.get().setX(args.getDouble(1));
+                loc.get().setY(args.getDouble(2));
+                loc.get().setZ(args.getDouble(3));
+            }
+
+            if (args.hasFlag('s')) {
+                npc.getNavigator().setStraightLineTarget(loc.get());
+            } else {
+                npc.getNavigator().setTarget(loc.get());
+            }
+            if (margin != null) {
+                npc.getNavigator().getLocalParameters().distanceMargin(margin);
+            }
+        }, null);
     }
 
     @Command(
diff --git a/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java b/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java
index f0302ec11..eb6f5c5a0 100644
--- a/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java
+++ b/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java
@@ -336,6 +336,7 @@ public class CitizensNavigator implements Navigator, Runnable {
 
     @Override
     public void setTarget(Function<NavigatorParameters, PathStrategy> strategy) {
+        npc.getEntity().getScheduler().run(CitizensAPI.getPlugin(), task -> {
         if (!npc.isSpawned())
             throw new IllegalStateException("npc is not spawned");
 
@@ -364,6 +365,7 @@ public class CitizensNavigator implements Navigator, Runnable {
             updateTicket(executing.getTargetAsLocation());
         }
         Bukkit.getPluginManager().callEvent(new NavigationBeginEvent(this));
+        }, null);
     }
 
     @Override
@@ -395,6 +397,7 @@ public class CitizensNavigator implements Navigator, Runnable {
             return;
         }
         Location target = targetIn.clone();
+        org.bukkit.Bukkit.getRegionScheduler().execute(CitizensAPI.getPlugin(), target, () -> {
         setTarget(params -> {
             if (npc.isFlyable()) {
                 return new FlyingAStarNavigationStrategy(npc, target, params);
@@ -405,6 +408,7 @@ public class CitizensNavigator implements Navigator, Runnable {
                 return new MCNavigationStrategy(npc, target, params);
             }
         });
+        });
     }
 
     private void stopNavigating() {
@@ -548,7 +552,7 @@ public class CitizensNavigator implements Navigator, Runnable {
             return;
         }
         activeTicket = target.clone();
-        activeTicket.getChunk().addPluginChunkTicket(CitizensAPI.getPlugin());
+        org.bukkit.Bukkit.getRegionScheduler().execute(CitizensAPI.getPlugin(), activeTicket, () ->  activeTicket.getChunk().addPluginChunkTicket(CitizensAPI.getPlugin()));
     }
 
     private static boolean SUPPORT_CHUNK_TICKETS = true;
diff --git a/main/src/main/java/net/citizensnpcs/npc/ai/MCNavigationStrategy.java b/main/src/main/java/net/citizensnpcs/npc/ai/MCNavigationStrategy.java
index 886a61f17..cf920f4c4 100644
--- a/main/src/main/java/net/citizensnpcs/npc/ai/MCNavigationStrategy.java
+++ b/main/src/main/java/net/citizensnpcs/npc/ai/MCNavigationStrategy.java
@@ -34,9 +34,6 @@ public class MCNavigationStrategy extends AbstractPathStrategy {
 
     MCNavigationStrategy(NPC npc, Location dest, NavigatorParameters params) {
         super(TargetType.LOCATION);
-        if (!MinecraftBlockExaminer.canStandIn(dest.getBlock())) {
-            dest = MinecraftBlockExaminer.findValidLocationAbove(dest, 2);
-        }
         target = Util.getCenterLocation(dest.getBlock());
         parameters = params;
         entity = npc.getEntity();
