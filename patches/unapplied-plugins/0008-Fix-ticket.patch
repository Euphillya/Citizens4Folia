From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Sat, 22 Mar 2025 02:08:32 +0100
Subject: [PATCH 08/15] Fix ticket

---
 .../main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java b/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java
index c483ab5ce..f0302ec11 100644
--- a/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java
+++ b/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java
@@ -424,7 +424,7 @@ public class CitizensNavigator implements Navigator, Runnable {
         if (!SUPPORT_CHUNK_TICKETS || !CitizensAPI.hasImplementation() || !CitizensAPI.getPlugin().isEnabled())
             return;
 
-        Bukkit.getRegionScheduler().runDelayed(CitizensAPI.getPlugin(), executing.getTargetAsLocation(),
+        Bukkit.getGlobalRegionScheduler().runDelayed(CitizensAPI.getPlugin(),
                 (task) -> updateTicket(isNavigating() ? executing.getTargetAsLocation() : null), 10);
 
         // Location loc = npc.getEntity().getLocation(STATIONARY_LOCATION);
@@ -540,7 +540,8 @@ public class CitizensNavigator implements Navigator, Runnable {
 
         // switch ticket to the new chunk
         if (activeTicket != null) {
-            activeTicket.getChunk().removePluginChunkTicket(CitizensAPI.getPlugin());
+            final Location finalActiveTicket = activeTicket.clone();
+            Bukkit.getRegionScheduler().execute(CitizensAPI.getPlugin(), finalActiveTicket, () -> finalActiveTicket.getChunk().removePluginChunkTicket(CitizensAPI.getPlugin()));
         }
         if (target == null) {
             activeTicket = null;
