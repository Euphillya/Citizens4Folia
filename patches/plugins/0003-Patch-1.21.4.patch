+    private void setTrackedEntity(Entity entity, TrackedEntity trackedEntity) {
+        try {
+            java.lang.reflect.Field field = Entity.class.getDeclaredField("trackedEntity");
+            field.setAccessible(true);
+            field.set(entity, trackedEntity);
+        } catch (Exception exception) {
+            exception.printStackTrace();
+        }
+    }
+
+    private static TrackedEntity getTrackedEntity(Entity entity) {
+        try {
+            java.lang.reflect.Field field = Entity.class.getDeclaredField("trackedEntity");
+            field.setAccessible(true);
+            Object trackerObject = field.get(entity);
+            return (TrackedEntity) trackerObject;
+        } catch (Exception exception) {
+            exception.printStackTrace();
+            return null;
+        }
+    }
