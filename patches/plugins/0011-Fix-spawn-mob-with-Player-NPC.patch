From cf1b38d3de6e10330cebae7d81a32b87eafeae33 Mon Sep 17 00:00:00 2001
From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Thu, 13 Feb 2025 00:43:46 +0100
Subject: [PATCH 11/14] Fix spawn mob with Player NPC

---
 .../java/net/citizensnpcs/commands/NPCCommands.java  | 12 +++++++++---
 .../main/java/net/citizensnpcs/npc/CitizensNPC.java  | 12 +++++++++---
 2 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java b/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
index 575383bca..76e0a8993 100644
--- a/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
+++ b/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
@@ -948,9 +948,15 @@ public class NPCCommands {
         if (!args.hasFlag('u')) {
             final Location locationSpawn = spawnLoc;
             final NPC npcFinal = npc;
-            org.bukkit.Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), locationSpawn.getWorld().getSpawnLocation(), task -> {
-                npcFinal.spawn(locationSpawn, SpawnReason.CREATE);
-            });
+            if (type.equals(EntityType.PLAYER)) {
+                org.bukkit.Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), locationSpawn.getWorld().getSpawnLocation(), task -> {
+                    npcFinal.spawn(locationSpawn, SpawnReason.CREATE);
+                });
+            } else {
+                org.bukkit.Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), locationSpawn, task -> {
+                    npcFinal.spawn(locationSpawn, SpawnReason.CREATE);
+                });
+            }
         }
         selector.select(sender, npc);
         history.add(sender, new CreateNPCHistoryItem(npc));
diff --git a/main/src/main/java/net/citizensnpcs/npc/CitizensNPC.java b/main/src/main/java/net/citizensnpcs/npc/CitizensNPC.java
index e26802f8d..92dcab70a 100644
--- a/main/src/main/java/net/citizensnpcs/npc/CitizensNPC.java
+++ b/main/src/main/java/net/citizensnpcs/npc/CitizensNPC.java
@@ -185,9 +185,15 @@ public class CitizensNPC extends AbstractNPC {
         CurrentLocation spawnLocation = getOrAddTrait(CurrentLocation.class);
         if (getOrAddTrait(Spawned.class).shouldSpawn() && spawnLocation.getLocation() != null) {
             if (spawnLocation.getLocation() != null) {
-                org.bukkit.Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), spawnLocation.getLocation().getWorld().getSpawnLocation(), task -> {
-                    spawn(spawnLocation.getLocation(), SpawnReason.RESPAWN);
-                });
+                if (this.getEntityType().equals(EntityType.PLAYER)) {
+                    org.bukkit.Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), spawnLocation.getLocation().getWorld().getSpawnLocation(), task -> {
+                        spawn(spawnLocation.getLocation(), SpawnReason.RESPAWN);
+                    });
+                } else {
+                    org.bukkit.Bukkit.getRegionScheduler().run(CitizensAPI.getPlugin(), spawnLocation.getLocation(), task -> {
+                        spawn(spawnLocation.getLocation(), SpawnReason.RESPAWN);
+                    });
+                }
             } else {
                 Messaging.debug("Tried to spawn", this, "on load but world was null");
             }
-- 
