+++ b/main/src/main/java/net/citizensnpcs/npc/ai/CitizensNavigator.java
@@ -335,34 +335,36 @@ public class CitizensNavigator implements Navigator, Runnable {
 
     @Override
     public void setTarget(Function<NavigatorParameters, PathStrategy> strategy) {
-        if (!npc.isSpawned())
-            throw new IllegalStateException("npc is not spawned");
-
-        if (executing != null) {
-            stopNavigating(CancelReason.REPLACE);
-        }
-        localParams = defaultParams.clone();
+        npc.getEntity().getScheduler().run(CitizensAPI.getPlugin(), task -> {
+            if (!npc.isSpawned())
+                throw new IllegalStateException("npc is not spawned");
 
-        if (localParams.useNewPathfinder()) {
-            int fallDistance = localParams.fallDistance();
-            if (fallDistance != -1) {
-                localParams.examiner(new FallingExaminer(fallDistance));
+            if (executing != null) {
+                stopNavigating(CancelReason.REPLACE);
             }
-            if (npc.data().get(NPC.Metadata.PATHFINDER_OPEN_DOORS, Setting.NEW_PATHFINDER_OPENS_DOORS.asBoolean())) {
-                localParams.examiner(new DoorExaminer());
+            localParams = defaultParams.clone();
+
+            if (localParams.useNewPathfinder()) {
+                int fallDistance = localParams.fallDistance();
+                if (fallDistance != -1) {
+                    localParams.examiner(new FallingExaminer(fallDistance));
+                }
+                if (npc.data().get(NPC.Metadata.PATHFINDER_OPEN_DOORS, Setting.NEW_PATHFINDER_OPENS_DOORS.asBoolean())) {
+                    localParams.examiner(new DoorExaminer());
+                }
+                if (Setting.NEW_PATHFINDER_CHECK_BOUNDING_BOXES.asBoolean()) {
+                    localParams.examiner(new BoundingBoxExaminer(npc.getEntity()));
+                }
             }
-            if (Setting.NEW_PATHFINDER_CHECK_BOUNDING_BOXES.asBoolean()) {
-                localParams.examiner(new BoundingBoxExaminer(npc.getEntity()));
+            updatePathfindingRange();
+            executing = strategy.apply(localParams);
+            stationaryTicks = 0;
+            if (npc.isSpawned()) {
+                NMS.updateNavigationWorld(npc.getEntity(), npc.getEntity().getWorld());
+                updateTicket(executing.getTargetAsLocation());
             }
-        }
-        updatePathfindingRange();
-        executing = strategy.apply(localParams);
-        stationaryTicks = 0;
-        if (npc.isSpawned()) {
-            NMS.updateNavigationWorld(npc.getEntity(), npc.getEntity().getWorld());
-            updateTicket(executing.getTargetAsLocation());
-        }
-        Bukkit.getPluginManager().callEvent(new NavigationBeginEvent(this));
+            Bukkit.getPluginManager().callEvent(new NavigationBeginEvent(this));
+        }, null);
     }
 
     @Override
@@ -392,15 +394,23 @@ public class CitizensNavigator implements Navigator, Runnable {
             cancelNavigation();
             return;
         }
-        Location target = targetIn.clone();
-        setTarget(params -> {
-            if (npc.isFlyable()) {
-                return new FlyingAStarNavigationStrategy(npc, target, params);
-            } else if (params.useNewPathfinder() || !(npc.getEntity() instanceof LivingEntity)) {
-                return new AStarNavigationStrategy(npc, target, params);
-            } else {
-                return new MCNavigationStrategy(npc, target, params);
+        final Location target = targetIn.clone();
+        org.bukkit.Bukkit.getRegionScheduler().execute(CitizensAPI.getPlugin(), target, () -> {
+            Location targetTmp = target;
+            // Prescan for MCNavigationStrategy
+            if (!MinecraftBlockExaminer.canStandIn(targetTmp.getBlock())) {
+                targetTmp = MinecraftBlockExaminer.findValidLocationAbove(targetTmp, 2);
             }
+            final Location targetFinal = targetTmp;
+            setTarget(params -> {
+                if (npc.isFlyable()) {
+                    return new FlyingAStarNavigationStrategy(npc, target, params);
+                } else if (params.useNewPathfinder() || !(npc.getEntity() instanceof LivingEntity)) {
+                    return new AStarNavigationStrategy(npc, target, params);
+                } else {
+                    return new MCNavigationStrategy(npc, targetFinal, params);
+                }
+            });
         });
     }
 
@@ -545,7 +555,7 @@ public class CitizensNavigator implements Navigator, Runnable {
             return;
         }
         activeTicket = target.clone();
-        activeTicket.getChunk().addPluginChunkTicket(CitizensAPI.getPlugin());
+        org.bukkit.Bukkit.getRegionScheduler().execute(CitizensAPI.getPlugin(), activeTicket, () ->  activeTicket.getChunk().addPluginChunkTicket(CitizensAPI.getPlugin()));
     }
 
     private static boolean SUPPORT_CHUNK_TICKETS = true;
