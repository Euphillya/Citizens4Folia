From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Thu, 13 Feb 2025 00:43:45 +0100
Subject: [PATCH 06/14] Fix npc sitting

---
 .../net/citizensnpcs/nms/v1_21_R3/util/NMSImpl.java | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/v1_21_R3/src/main/java/net/citizensnpcs/nms/v1_21_R3/util/NMSImpl.java b/v1_21_R3/src/main/java/net/citizensnpcs/nms/v1_21_R3/util/NMSImpl.java
index 846eb766c..4e3a341bb 100644
--- a/v1_21_R3/src/main/java/net/citizensnpcs/nms/v1_21_R3/util/NMSImpl.java
+++ b/v1_21_R3/src/main/java/net/citizensnpcs/nms/v1_21_R3/util/NMSImpl.java
@@ -1819,10 +1819,15 @@ public class NMSImpl implements NMSBridge {
 
     @Override
     public void setStepHeight(org.bukkit.entity.Entity entity, float height) {
-        Entity handle = getHandle(entity);
-        if (!(handle instanceof LivingEntity))
-            return;
-        ((LivingEntity) handle).getAttribute(Attributes.STEP_HEIGHT).setBaseValue(height);
+        new fr.euphyllia.utils.FoliaRunnable(entity, null) {
+            @Override
+            public void run() {
+                Entity handle = getHandle(entity);
+                if (!(handle instanceof LivingEntity))
+                    return;
+                ((LivingEntity) handle).getAttribute(Attributes.STEP_HEIGHT).setBaseValue(height);
+            }
+        }.run(CitizensAPI.getPlugin());
     }
 
     @Override
