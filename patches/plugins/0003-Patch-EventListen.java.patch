             Messaging.idebug(() -> Joiner.on(' ').join("Loading chunk in 10 ticks due to forced chunk load at", coord));
-            Bukkit.getScheduler().scheduleSyncDelayedTask(plugin, () -> {
+            final org.bukkit.Chunk chunk = event.getChunk();  CitizensAPI.getScheduler().runRegionTaskLater(chunk.getWorld(), chunk.getX(), chunk.getZ(), () -> {
                 if (!event.getChunk().isLoaded()) {
                     event.getChunk().load();
                 }
