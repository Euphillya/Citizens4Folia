             }
-        }.runTaskTimer(plugin, 0, 1);
+        }.runEntityTaskTimer(plugin, event.getEntity(), null, 0, 1);
     }
 
     @EventHandler
@@ -932,11 +932,11 @@ public class EventListen implements Listener {
                     if (!npcMoveEvent.isCancelled()) {
