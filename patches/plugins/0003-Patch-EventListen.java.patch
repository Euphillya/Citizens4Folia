 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/main/src/main/java/net/citizensnpcs/EventListen.java b/main/src/main/java/net/citizensnpcs/EventListen.java
index 73fc083b5..d219d031f 100644
