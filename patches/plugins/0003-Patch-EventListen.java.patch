-                event.getPlayer().teleport(event.getTo());
+                SpigotUtil.teleportAsync(event.getPlayer(), event.getTo());
                 npc.data().remove("citizens-force-teleporting");
             }, Setting.PLAYER_TELEPORT_DELAY.asTicks());
         }
@@ -789,7 +789,7 @@ public class EventListen implements Listener {
         if (!(event.getEntity() instanceof FishHook))
             return;
         NMS.removeHookIfNecessary((FishHook) event.getEntity());
-        new BukkitRunnable() {
+        new net.citizensnpcs.api.util.schedulers.SchedulerRunnable() {
             int n = 0;
 
             @Override
@@ -800,7 +800,7 @@ public class EventListen implements Listener {
                 }
