+++ b/main/src/main/java/net/citizensnpcs/util/ChunkCoord.java
@@ -57,7 +57,7 @@ public class ChunkCoord {
             return;
         Chunk chunk = getChunk();
         if (chunk != null) {
-            chunk.setForceLoaded(b);
+            org.bukkit.Bukkit.getGlobalRegionScheduler().execute(net.citizensnpcs.api.CitizensAPI.getPlugin(), () -> chunk.setForceLoaded(b));
         }
     }
 
