Subject: [PATCH 09/14] Fix ForceLoad

---
 main/src/main/java/net/citizensnpcs/util/ChunkCoord.java | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/main/src/main/java/net/citizensnpcs/util/ChunkCoord.java b/main/src/main/java/net/citizensnpcs/util/ChunkCoord.java
index a3a25356f..31a1450e8 100644
--- a/main/src/main/java/net/citizensnpcs/util/ChunkCoord.java
+++ b/main/src/main/java/net/citizensnpcs/util/ChunkCoord.java
@@ -57,7 +57,7 @@ public class ChunkCoord {
             return;
         Chunk chunk = getChunk();
         if (chunk != null) {
-            chunk.setForceLoaded(b);
+            org.bukkit.Bukkit.getGlobalRegionScheduler().execute(net.citizensnpcs.api.CitizensAPI.getPlugin(), () -> chunk.setForceLoaded(b));
         }
     }
 
