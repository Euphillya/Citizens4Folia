+        Entity handle = getHandle(entity);
+        if (handle == null)
+            return;
+        yaw = Util.clamp(yaw);
+        handle.setYRot(yaw);
+        setHeadYaw(entity, yaw);
+        handle.setXRot(pitch);
+    }
