Subject: [PATCH 09/41] npc skin SkinPacketTracker.java

---
 .../java/net/citizensnpcs/npc/skin/SkinPacketTracker.java   | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/main/src/main/java/net/citizensnpcs/npc/skin/SkinPacketTracker.java b/main/src/main/java/net/citizensnpcs/npc/skin/SkinPacketTracker.java
index dcf7f75e4..d6f18c832 100644
--- a/main/src/main/java/net/citizensnpcs/npc/skin/SkinPacketTracker.java
+++ b/main/src/main/java/net/citizensnpcs/npc/skin/SkinPacketTracker.java
@@ -56,7 +56,7 @@ public class SkinPacketTracker {
      */
     public void onSpawnNPC() {
         isRemoved = false;
-        new BukkitRunnable() {
+        new net.citizensnpcs.api.util.schedulers.SchedulerRunnable() {
             @Override
             public void run() {
                 if (!entity.getNPC().isSpawned())
@@ -65,7 +65,7 @@ public class SkinPacketTracker {
                 updateNearbyViewers(entity.getNPC().data().get(NPC.Metadata.TRACKING_RANGE,
                         Setting.NPC_SKIN_VIEW_DISTANCE.asInt()));
             }
-        }.runTaskLater(CitizensAPI.getPlugin(), 15);
+        }.runEntityTaskLater(CitizensAPI.getPlugin(), entity.getNPC().getEntity(), null, 15);
     }
 
     /**
@@ -98,7 +98,7 @@ public class SkinPacketTracker {
 
         skin.apply(entity);
         if (NMS.sendTabListAdd(player, entity.getBukkitEntity())) {
-            Bukkit.getScheduler().scheduleSyncDelayedTask(CitizensAPI.getPlugin(),
+            CitizensAPI.getScheduler().runEntityTaskLater(player,
                     () -> NMS.sendTabListRemove(player, entity.getBukkitEntity()),
                     Setting.TABLIST_REMOVE_PACKET_DELAY.asTicks());
         }
