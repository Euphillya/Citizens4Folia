From d95715fa27b542437c4b5c6649e3eb26c9799a00 Mon Sep 17 00:00:00 2001
From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Tue, 25 Feb 2025 03:48:45 +0100
Subject: [PATCH 15/16] Change teleport to teleportAsync

---
 main/src/main/java/net/citizensnpcs/EventListen.java      | 6 +++---
 .../main/java/net/citizensnpcs/commands/NPCCommands.java  | 4 ++--
 .../main/java/net/citizensnpcs/trait/HologramTrait.java   | 8 ++++----
 main/src/main/java/net/citizensnpcs/trait/SitTrait.java   | 2 +-
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/main/src/main/java/net/citizensnpcs/EventListen.java b/main/src/main/java/net/citizensnpcs/EventListen.java
index eee472fc0..ccacf7b70 100644
--- a/main/src/main/java/net/citizensnpcs/EventListen.java
+++ b/main/src/main/java/net/citizensnpcs/EventListen.java
@@ -745,7 +745,7 @@ public class EventListen implements Listener {
             event.setCancelled(true);
             event.getPlayer().getScheduler().runDelayed(plugin, (task) -> {
                 npc.data().set("citizens-force-teleporting", true);
-                event.getPlayer().teleport(event.getTo());
+                event.getPlayer().teleportAsync(event.getTo());
                 npc.data().remove("citizens-force-teleporting");
             }, null, Math.max(1, Setting.PLAYER_TELEPORT_DELAY.asTicks()));
         }
@@ -937,11 +937,11 @@ public class EventListen implements Listener {
                     if (!npcMoveEvent.isCancelled()) {
                         final Location eventTo = npcMoveEvent.getTo();
                         if (!to.equals(eventTo)) {
-                            entity.getScheduler().runDelayed(plugin, (task) -> entity.teleport(eventTo), null, 1L);
+                            entity.getScheduler().runDelayed(plugin, (task) -> entity.teleportAsync(eventTo), null, 1L);
                         }
                     } else {
                         final Location eventFrom = npcMoveEvent.getFrom();
-                        entity.getScheduler().runDelayed(plugin, (task) -> entity.teleport(eventFrom), null, 1L);
+                        entity.getScheduler().runDelayed(plugin, (task) -> entity.teleportAsync(eventFrom), null, 1L);
                     }
                 } catch (Throwable ex) {
                     ex.printStackTrace();
diff --git a/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java b/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
index ec3899a7b..3edbf9a47 100644
--- a/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
+++ b/main/src/main/java/net/citizensnpcs/commands/NPCCommands.java
@@ -3520,7 +3520,7 @@ public class NPCCommands {
             to = to.clone().add(to.getDirection().setY(0));
             to.setDirection(to.getDirection().multiply(-1)).setPitch(0);
         }
-        player.teleport(to, TeleportCause.COMMAND);
+        player.teleportAsync(to, TeleportCause.COMMAND);
         Messaging.sendTr(player, Messages.TELEPORTED_TO_NPC, npc.getName());
     }
 
@@ -3621,7 +3621,7 @@ public class NPCCommands {
             throw new CommandException(Messages.FROM_ENTITY_NOT_FOUND);
         if (to == null)
             throw new CommandException(Messages.TPTO_ENTITY_NOT_FOUND);
-        from.teleport(to);
+        from.teleportAsync(to.getLocation());
         Messaging.sendTr(sender, Messages.TPTO_SUCCESS);
     }
 
diff --git a/main/src/main/java/net/citizensnpcs/trait/HologramTrait.java b/main/src/main/java/net/citizensnpcs/trait/HologramTrait.java
index dc7f1e5b2..feef95616 100644
--- a/main/src/main/java/net/citizensnpcs/trait/HologramTrait.java
+++ b/main/src/main/java/net/citizensnpcs/trait/HologramTrait.java
@@ -467,7 +467,7 @@ public class HologramTrait extends Trait {
                 cloud.setRadius(0);
                 cloud.setParticle(Particle.BLOCK_MARKER, Bukkit.createBlockData(Material.AIR));
             }
-            hologram.getEntity().teleport(
+            hologram.getEntity().teleportAsync(
                     npc.getEntity().getLocation().clone().add(offset.x,
                             offset.y + NMS.getBoundingBoxHeight(npc.getEntity()) - 0.5, offset.z),
                     TeleportCause.PLUGIN);
@@ -484,7 +484,7 @@ public class HologramTrait extends Trait {
 
         @Override
         protected void render0(NPC npc, Vector3d offset) {
-            hologram.getEntity().teleport(npc.getEntity().getLocation().clone().add(offset.x,
+            hologram.getEntity().teleportAsync(npc.getEntity().getLocation().clone().add(offset.x,
                     offset.y + NMS.getBoundingBoxHeight(npc.getEntity()), offset.z), TeleportCause.PLUGIN);
         }
     }
@@ -806,7 +806,7 @@ public class HologramTrait extends Trait {
 
         @Override
         protected void render0(NPC npc, Vector3d offset) {
-            hologram.getEntity().teleport(npc.getEntity().getLocation().clone().add(offset.x,
+            hologram.getEntity().teleportAsync(npc.getEntity().getLocation().clone().add(offset.x,
                     offset.y + NMS.getBoundingBoxHeight(npc.getEntity()), offset.z), TeleportCause.PLUGIN);
         }
 
@@ -958,7 +958,7 @@ public class HologramTrait extends Trait {
                     disp.setTransformation(tf);
                 }
             }
-            hologram.getEntity().teleport(
+            hologram.getEntity().teleportAsync(
                     base.getEntity().getLocation().clone().add(offset.x,
                             offset.y + NMS.getBoundingBoxHeight(base.getEntity()) + 0.2f, offset.z),
                     TeleportCause.PLUGIN);
diff --git a/main/src/main/java/net/citizensnpcs/trait/SitTrait.java b/main/src/main/java/net/citizensnpcs/trait/SitTrait.java
index 0da40451b..ae0ac6b8c 100644
--- a/main/src/main/java/net/citizensnpcs/trait/SitTrait.java
+++ b/main/src/main/java/net/citizensnpcs/trait/SitTrait.java
@@ -42,7 +42,7 @@ public class SitTrait extends Trait {
                 if (requiresPassengerOffsetCorrection()) {
                     npcLoc = npcLoc.add(0, 0.3, 0);
                 }
-                npc.getEntity().teleport(npcLoc);
+                npc.getEntity().teleportAsync(npcLoc);
             }
             chair.destroy();
             chair = null;
-- 
2.48.1.windows.1

