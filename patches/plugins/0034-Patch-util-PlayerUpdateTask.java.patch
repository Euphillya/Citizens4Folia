 .../main/java/net/citizensnpcs/util/PlayerUpdateTask.java  | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/main/src/main/java/net/citizensnpcs/util/PlayerUpdateTask.java b/main/src/main/java/net/citizensnpcs/util/PlayerUpdateTask.java
index 1d23e9619..038c8f5cb 100644
--- a/main/src/main/java/net/citizensnpcs/util/PlayerUpdateTask.java
+++ b/main/src/main/java/net/citizensnpcs/util/PlayerUpdateTask.java
@@ -21,7 +21,7 @@ import net.citizensnpcs.trait.PacketNPC;
 
 public class PlayerUpdateTask extends net.citizensnpcs.api.util.schedulers.SchedulerRunnable {
     private final List<PlayerTick> players = Lists.newArrayList();
-    private final Set<UUID> uuids = Sets.newHashSet();
+    private final Set<UUID> uuids = java.util.concurrent.ConcurrentHashMap.newKeySet();
 
     @Override
     public void cancel() {
@@ -42,6 +42,7 @@ public class PlayerUpdateTask extends net.citizensnpcs.api.util.schedulers.Sched
             PLAYERS_PENDING_REMOVE.clear();
         }
         for (Entity entity : PLAYERS_PENDING_ADD) {
+            net.citizensnpcs.api.CitizensAPI.getScheduler().runEntityTask(entity, () ->  {
             NPC next = ((NPCHolder) entity).getNPC();
             if (uuids.contains(entity.getUniqueId())) {
                 // XXX: how often does this case get hit? can simplify implementation
@@ -67,7 +68,7 @@ public class PlayerUpdateTask extends net.citizensnpcs.api.util.schedulers.Sched
                 players.add(new PlayerTick(entity, NMS.playerTicker((Player) entity)));
             }
             uuids.add(entity.getUniqueId());
-        }
+        })};
         PLAYERS_PENDING_ADD.clear();
 
         for (PlayerTick player : players) {
@@ -86,7 +87,7 @@ public class PlayerUpdateTask extends net.citizensnpcs.api.util.schedulers.Sched
 
         @Override
         public void run() {
-            tick.run();
+            net.citizensnpcs.api.CitizensAPI.getScheduler().runEntityTask(entity, tick);
         }
     }
 
